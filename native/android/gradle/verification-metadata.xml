<?xml version="1.0" encoding="UTF-8"?>
<!-- Dependency verification for the one artifact that does not come from Google or
     Maven Central: LiveKit's audio routing library, built by JitPack from a pinned
     commit. JitPack builds it itself, so the bytes are pinned here too — a rebuilt or
     swapped artifact fails the build. Everything else is trusted as before. -->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!com[.]github[.]davidliu$).*$" regex="true" reason="Only the JitPack artifact is pinned"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="com.github.davidliu" name="audioswitch" version="039a35aefab7747c557242fa216c9ea11743b604">
