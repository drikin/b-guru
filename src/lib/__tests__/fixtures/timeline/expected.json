{
  "version": 1,
  "notes": {
    "9002": "ちょうど 500 は畳まない",
    "9003": "501 で畳む",
    "9004": "500 番目の手前で絵文字が割れるので 499 で切る",
    "9005": "Markdown の長文",
    "9013": "URL が 2 つ: カードは最初の 1 件（url_preview の url）",
    "9014": "カードの取得前: カードは出さない",
    "9015": "件数の多い順・同数は UTF-16 順（❤️ U+2764 < 👍 U+1F44D、:drikin: < 🎉）",
    "9016": "12 人＋他2人",
    "9017": "@名前・@[空白入り]・大文字小文字無視・会員でない @unknown は対象外",
    "9018": "@drikinさん は区切りが無いので対象外（Web と同じ）",
    "9019": "プロフィールへのリンク",
    "9022": "削除済みの部活も名前で出す",
    "9023": "返信も同じ判断",
    "9026": "古い形のメールのユーザーリンクは user_links に出さない（メールを返さない）",
    "9027": "空の本文",
    "9028": "画像だけ（本文なし）",
    "9029": "名前が 0 件でも count 3 → 他3人",
    "9030": "13 人＝12 人＋他1人、12 人ちょうど＝他0人",
    "9031": "ZWJ の家族絵文字が 500 をまたぐ: 499 は低サロゲートなので 500 で切る（字の途中で切れるのは Web と同じ）",
    "9032": "国旗が 500 をまたぐ: 499 が高サロゲートなので 499 で切る",
    "9033": "結合文字（か＋濁点 U+3099）が 500 をまたぐ: 500 で切る",
    "9034": "同数で UTF-16 順とコードポイント順が逆になる組: 👍(D83D…) < ｗ(FF57) なので 👍 が先（コードポイント順なら ｗ が先）",
    "9035": "絵文字（2 単位）の直後のメンション",
    "9036": "U+FEFF は JS の \\s に入るので区切りになる、U+0085 は入らないので区切りにならない",
    "9037": "videoId が空文字なら普通のカード",
    "9038": "Spotify の高さ 0 は 152 として扱う"
  },
